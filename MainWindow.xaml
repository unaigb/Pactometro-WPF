<Window x:Name="VentanaPrincipal"
        x:Class="El_Pactometro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        xmlns:local="clr-namespace:El_Pactometro"
        mc:Ignorable="d"
        Title="El Pactómetro" MinHeight="650" Height="650" MinWidth="900" Width="900" SizeChanged="Window_SizeChanged" StateChanged="Window_StateChanged" WindowStartupLocation="CenterScreen" Icon="Media/Icono.png">

    <Window.Resources>
        <Style TargetType="Button" x:Key="BotonPersonalizado">
            <Setter Property="Background" Value="#1E49CA"/>
            <Setter Property="Foreground" Value="GhostWhite"/>
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontFamily" Value="{StaticResource Baloo}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel x:Name="panelMenu">
        <Menu x:Name="Menu" DockPanel.Dock="Top" Visibility="Hidden">
            <MenuItem Click="IntDatos_Click" ToolTip="Introducir datos">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Media/añadir.png" Width="20" Height="20" Margin="7,3,7,3"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Click="GuardarImagen_Click" ToolTip="Permite guardar en un fichero de imagen con extensión .png de la gráfica mostrada en el momento">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Media/screenshot.png" Width="20" Height="20" Margin="8,2,6,0"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Click="Ayuda_Click" ToolTip="Botón de Ayuda">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Media/ayuda.png" Width="23" Height="23" Margin="7,0,7,0"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
        </Menu>

        <Grid x:Name="pantalla" Height="Auto">
            <!-- Contenido principal de la aplicación -->
            <Grid x:Name="miGrid" Background="Transparent" Visibility="Hidden">
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"/>
                    <RowDefinition />
                    <RowDefinition Height="95"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <Viewbox Grid.Row="0" Grid.Column="1" Margin="30,0,30,60" >
                    <Label Name="tipoGrafico" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="300" FontFamily="{StaticResource Baloo}"/>
                </Viewbox>
                <Viewbox Grid.Row="0" Grid.Column="1" Margin="30,60,30,0" >
                    <Label Name="elecSeleccionada" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" FontFamily="{StaticResource Baloo}"/>
                </Viewbox>

                <Border x:Name="contenedor" Background="Beige" Grid.Column="1" Grid.Row="1" CornerRadius="20" BorderBrush="Black" BorderThickness="1">
                    <ScrollViewer x:Name="scrollBarra" HorizontalScrollBarVisibility="Hidden"  VerticalScrollBarVisibility="Disabled" Margin="0,0,0,21">
                        <Canvas Name="miCanvas" Background="Transparent"/>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Button Name="botonIzq" Style="{StaticResource BotonPersonalizado}" Content="COMPARAR" Grid.Column="0" Margin="100,23,20,23" Click="botonIzquierdo_Click"/>
                    <Button Name="botonDer" Style="{StaticResource BotonPersonalizado}" Content="PACTÓMETRO" Grid.Column="1" Margin="20,23,100,23" Click="botonDerecho_Click"/>
                </Grid>
            </Grid>

            <!-- Pantalla de carga -->
            <Grid x:Name="loadingGrid" Background="#1E49CA" Visibility="Visible" Margin="0,-28,0,0">
                <MediaElement x:Name="gifPlayer" Source="Media/PACTÓMETRO.gif" LoadedBehavior="Play" HorizontalAlignment="Center" Width="492" Margin="0,62,0,128"/>
                <Image gif:ImageBehavior.AnimatedSource="Media/progress-unscreen.gif" HorizontalAlignment="Center"  Width="78" Margin="0,262,0,111"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
